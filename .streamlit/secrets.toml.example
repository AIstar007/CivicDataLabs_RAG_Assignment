# Copy these keys into Streamlit Community Cloud > App settings > Secrets.
# Do not commit a real secrets.toml file or replace these placeholders with real credentials.
AZURE_OPENAI_API_KEY = "replace_with_azure_openai_key"
AZURE_OPENAI_ENDPOINT = "https://YOUR-RESOURCE.openai.azure.com/"
AZURE_OPENAI_API_VERSION = "2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT = "your-chat-deployment"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "your-embedding-deployment"

SARVAM_API_KEY = "replace_with_sarvam_key"
SARVAM_CHAT_MODEL = "sarvam-105b"
SARVAM_MAX_TOKENS = 4096
SARVAM_REASONING_EFFORT = "none"
SARVAM_CHAT_URL = "https://api.sarvam.ai/v1/chat/completions"

PINECONE_API_KEY = "replace_with_pinecone_api_key"
PINECONE_INDEX_NAME = "civic-gender-budget"
PINECONE_NAMESPACE = "gender-budget"
PINECONE_CLOUD = "aws"
PINECONE_REGION = "us-east-1"

DATA_DIR = "data"
TOP_K = 10
RETRIEVAL_CANDIDATES = 40

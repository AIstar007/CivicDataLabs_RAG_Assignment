# Azure OpenAI (keep the real .env private; never commit it)
AZURE_OPENAI_API_KEY=replace_with_your_key
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# These must be the DEPLOYMENT NAMES in your Azure AI Foundry/OpenAI resource
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment

DATA_DIR=data
TOP_K=10
RETRIEVAL_CANDIDATES=40

# Sarvam-105B for Hindi/Hinglish query understanding and final Hindi answers
SARVAM_API_KEY=replace_with_your_sarvam_key
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_MAX_TOKENS=4096
SARVAM_REASONING_EFFORT=none

# Pinecone vector database (create a Serverless index automatically on first ingestion)
PINECONE_API_KEY=replace_with_your_pinecone_api_key
PINECONE_INDEX_NAME=civic-gender-budget
PINECONE_NAMESPACE=gender-budget
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional override for Sarvam Chat Completions endpoint
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
